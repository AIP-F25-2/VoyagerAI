import React from "react";
import type { Activity } from "./types";

type DailyBudgetSummaryProps = {
  dateLabel: string;      // e.g. "Day 1 · Dec 20, 2025"
  activities: Activity[];
  dailyBudget: number;    // e.g. 120 (same currency as activity.cost)
  currencySymbol?: string; // e.g. "$", "€"
};

const DailyBudgetSummary: React.FC<DailyBudgetSummaryProps> = ({
  dateLabel,
  activities,
  dailyBudget,
  currencySymbol = "$",
}) => {
  const totalCost = activities.reduce(
    (sum, activity) => sum + (activity.cost ?? 0),
    0
  );

  const percentage =
    dailyBudget > 0 ? Math.min(100, (totalCost / dailyBudget) * 100) : 0;

  const isOverBudget = totalCost > dailyBudget;
  const diff = Math.abs(dailyBudget - totalCost);

  return (
    <div className="w-full rounded-2xl border border-slate-200 bg-white/80 p-4 shadow-sm">
      <div className="flex items-center justify-between mb-2">
        <h3 className="text-sm font-semibold text-slate-800">{dateLabel}</h3>
        <span
          className={`text-xs font-medium px-2 py-1 rounded-full ${
            isOverBudget
              ? "bg-red-100 text-red-700"
              : "bg-emerald-100 text-emerald-700"
          }`}
        >
          {isOverBudget ? "Over budget" : "Within budget"}
        </span>
      </div>

      {/* Numbers row */}
      <div className="flex items-baseline justify-between mb-2">
        <div className="text-xs text-slate-600">
          Daily budget:{" "}
          <span className="font-semibold text-slate-800">
            {currencySymbol}
            {dailyBudget.toFixed(2)}
          </span>
        </div>
        <div className="text-xs text-slate-600">
          Planned spend:{" "}
          <span
            className={`font-semibold ${
              isOverBudget ? "text-red-600" : "text-slate-800"
            }`}
          >
            {currencySymbol}
            {totalCost.toFixed(2)}
          </span>
        </div>
      </div>

      {/* Progress bar */}
      <div className="w-full h-2 rounded-full bg-slate-100 overflow-hidden mb-2">
        <div
          className={`h-full ${
            isOverBudget ? "bg-red-500" : "bg-emerald-500"
          }`}
          style={{ width: `${percentage}%` }}
        />
      </div>

      {/* Extra message */}
      <p className="text-[11px] text-slate-500">
        {isOverBudget
          ? `You’re about ${currencySymbol}${diff.toFixed(
              2
            )} over your daily budget. Consider swapping or removing one activity.`
          : `You still have about ${currencySymbol}${diff.toFixed(
              2
            )} available for this day.`}
      </p>
    </div>
  );
};

export default DailyBudgetSummary;
